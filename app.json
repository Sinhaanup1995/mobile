{
  "expo": {
    "name": "Propways Field",
    "slug": "propways-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/propways-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "propways",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Propways verifies your location when you check in at a site visit.",
        "NSCameraUsageDescription": "Propways needs your camera to capture the site visit photo."
      },
      "bundleIdentifier": "com.ariverr.propways-field"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071A33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/propways-logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Propways verifies your location when you check in at a site visit."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Propways needs your camera to capture the site visit photo."
        }
      ]
    ]
  }
}
